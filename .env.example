# ============================================================
#  WB Tariffs Service — Environment Variables
#  Copy this file to .env and fill in your real credentials
# ============================================================

# --- Wildberries API ---
# Bearer token from your WB seller account (hh.ru task provides this)
WB_API_TOKEN=your_wb_api_token_here

# --- Google Sheets ---
# Service account email (from Google Cloud Console → IAM → Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Service account private key (from the downloaded JSON key file, field "private_key")
# Keep the \n escape sequences — they will be unescaped at runtime
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"

# Comma-separated list of Google Spreadsheet IDs to update
# Example: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms,1abc...xyz
GOOGLE_SPREADSHEET_IDS=your_spreadsheet_id_1,your_spreadsheet_id_2

# --- PostgreSQL (pre-configured for docker-compose) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
