{
    "name": "wb-tariffs-service",
    "version": "1.0.0",
    "description": "Service for fetching WB box tariffs and syncing to Google Sheets",
    "main": "dist/app.js",
    "type": "module",
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec tsx src/app.ts",
        "watch:build": "tsc --build --force --verbose --watch",
        "knex:dev": "tsx src/utils/knex.ts",
        "build": "tsc --allowJs",
        "start": "node dist/app.js",
        "knex": "node dist/utils/knex.js",
        "tsc:check": "tsc --allowJs --noEmit",
        "prettier": "prettier --config .prettierrc.json src/**/*.ts --check",
        "prettier-format": "prettier --config .prettierrc.json src/**/*.ts --write"
    },
    "imports": {
        "#*": ["./dist/*", "./src/*"]
    },
    "_moduleAliases": {
        "#": "src"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.7.9",
        "dotenv": "^16.3.1",
        "googleapis": "^144.0.0",
        "knex": "^3.0.1",
        "log4js": "^6.9.1",
        "node-cron": "^3.0.3",
        "pg": "^8.11.3",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.11.10",
        "nodemon": "^3.0.2",
        "prettier": "^3.3.3",
        "prettier-plugin-jsdoc": "^1.3.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    }
}
